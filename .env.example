# The Supabase database Electrify reads from. These two values are baked into the
# app when it is built: people using the app never see or type them.
#
#   1. Copy this file to  .env
#   2. Fill in the two values (Supabase dashboard -> Project Settings -> API)
#   3. Restart Expo with:  npx expo start -c
#
# Use the PUBLIC key (called "anon" or "publishable"). It can only read the
# hourly / daily / monthly tables. NEVER put the service_role / secret key here:
# anything in the app can be extracted from it.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
